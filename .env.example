# Copy to .env.local and supply a key OR an external key file.
TYPESAFE_KEY_FILE=/absolute/path/to/jev.local.env
PORT=4317
HOST=0.0.0.0
# Optional public-terminal cap per IP, reset each local calendar day. Leave 0 or unset for unlimited use.
PUBLIC_DAILY_LIMIT=0
# Set 1 ONLY when the server sits behind a trusted local reverse proxy (e.g. Nginx -> 127.0.0.1).
# Per-IP quota then reads X-Forwarded-For. Never set it when the port is exposed directly.
TRUST_PROXY=0
